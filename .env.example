# Portaldot V3.0 testnet (EVM). The RPC URL is shared in the Portaldot Discord (discord.gg/portaldot).
PORTALDOT_RPC_URL=
# Optional: the deploy reads the chain ID from the RPC when this is empty.
PORTALDOT_CHAIN_ID=
# Optional: used to print explorer links after deploying.
PORTALDOT_EXPLORER_URL=

# Deployer private key, funded with test POT (never commit the real .env)
PRIVATE_KEY=

# Optional overrides
# RELAYER_ADDRESS=      defaults to the deployer
# REMOTE_CHAIN_ID=      bridge route, defaults to 31338
